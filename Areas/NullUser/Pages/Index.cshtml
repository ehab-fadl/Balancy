@page
@model Balancy.Areas.NullUser.Pages.IndexModel
@{
}
<div class="bg-shape bg-shape-1"></div>
<div class="bg-shape bg-shape-2"></div>
<div class="bg-shape bg-shape-3"></div>

<div class="glass-card">
    <div class="waiting-badge">بانتظار التفعيل</div>

    <div class="brand-logo-small">
        <i class="fa-solid fa-heart-pulse"></i>
        بالنسي <span>·</span> رعاية · أمل · شفاء
    </div>

    <div class="role-badge">
        <i class="fa-solid fa-user"></i>
        مستخدم جديد
    </div>

    <div class="icon-wrapper">
        <div class="pulse-ring"></div>
        <div class="pulse-ring"></div>
        <div class="pulse-ring"></div>
        <div class="icon-container">
            <i class="fa-solid fa-user-clock"></i>
        </div>
    </div>

    <div class="thank-you-text">
        <i class="fa-solid fa-heart" style="color: var(--bn-danger);"></i>
        شكراً لتسجيلك في بالنسي
    </div>

    <h1 class="page-title">حسابك في انتظار المراجعة</h1>

    <p class="page-subtitle">
        تم إنشاء حسابك بنجاح، ولكن يحتاج إلى تفعيل من قبل الإدارة.
    </p>

    <div class="alert-box">
        <i class="fa-solid fa-triangle-exclamation" style="margin-left: 6px;"></i>
        يجب مراجعة الأدمن لمنحك الصلاحيات المناسبة والدور المخصص لك في النظام.
    </div>

    <div class="info-box">
        <i class="fa-solid fa-envelope" style="color: var(--bn-primary); margin-left: 6px;"></i>
        سيتم إشعارك عبر البريد الإلكتروني فور تفعيل حسابك. نقدر صبرك وثقتك بنا.
    </div>

    <!-- الأزرار بجانب بعضها البعض بنفس الحجم -->
    <div class="d-flex justify-content-center align-items-center gap-3 flex-wrap">
        <a href="#" class="btn-custom-action btn-primary-custom">
            <i class="fa-solid fa-rotate-left"></i>
            العودة للرئيسية
        </a>
        <a href="#" class="btn-custom-action btn-outline-custom">
            <i class="fa-solid fa-right-from-bracket"></i>
            تسجيل الخروج
        </a>
    </div>
</div>