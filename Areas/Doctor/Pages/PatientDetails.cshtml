@page
@model Balancy.Areas.Doctor.Pages.PatientDetailsModel
@{
    Layout = null;
}


<main class="patient-main-content">

    <!-- Patient Code Bar -->
    <div class="code-card">
        <i class="fa-solid fa-link code-watermark"></i>
        <div class="patient-code-content">
            <div class="code-info">
                <div class="code-icon">
                    <i class="fa-solid fa-qrcode"></i>
                </div>
                <div>
                    <span class="code-label">كود المريض الشخصي</span>
                    <p class="code-note">يُستخدم لربط بيانات المريض مع تطبيق الموبايل</p>
                </div>
            </div>

            <div class="code-display" id="patientCode" aria-label="كود المريض">
                <span class="code-char letter">A</span>
                <span class="code-char letter">B</span>
                <span class="code-char">1</span>
                <span class="code-char">2</span>
                <span class="code-char">3</span>
                <span class="code-char">4</span>
                <span class="code-char">5</span>
                <span class="code-char">6</span>
            </div>

                       <a href="/Doctor/DocumentManager/DocumentManager"
                           class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-pill transition"
                           id="openDocsBtn"
                           title="فتح مدير وثائق المريض"
                           aria-label="فتح مدير وثائق المريض"
                           style="background-color: #0d6efd; border: none; font-weight: 500;">
                            <i class="fa-solid fa-file-lines"></i>
                            <span>الوثائق</span>
                       </a>

                       <a href="/Doctor/Reports/Report"
                           class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-pill transition"
                           id="openDocsBtn"
                           title="فتح مدير تقارير المريض"
                           aria-label="فتح مدير تقارير المريض"
                           style="background-color: #0d6efd; border: none; font-weight: 500;">
                            <i class="fa-solid fa-notes-medical"></i>
                            <span>التقارير</span>
                        </a>
    
            <button type="button" class="btn-copy" id="copyBtn" aria-label="نسخ كود المريض">
                <i class="fa-regular fa-copy ms-1"></i>
                نسخ الكود
            </button>
        </div>
    </div>

    <!-- Nav Groups -->
    <div class="nav-groups-wrapper">

        <!-- Group 1 -->
        <div class="nav-group">
            <div class="nav-group-header">
                <i class="fa-solid fa-user-circle"></i>
                <span>البيانات الأساسية</span>
                <span class="nav-group-count">6</span>
            </div>
            <nav class="patient-nav-tabs" role="tablist" aria-label="البيانات الأساسية">
                <button type="button" class="patient-tab-btn active" data-tab="personal" role="tab" aria-selected="true">
                    <i class="fa-solid fa-id-card"></i>
                    البيانات الشخصية
                </button>
                <button type="button" class="patient-tab-btn" data-tab="depressionStory" role="tab" aria-selected="false">
                    <i class="fa-solid fa-book-medical"></i>
                    قصة الاكتئاب
                </button>
                <button type="button" class="patient-tab-btn" data-tab="chronic" role="tab" aria-selected="false">
                    <i class="fa-solid fa-notes-medical"></i>
                    الأمراض المزمنة
                    <span class="tab-badge" id="badgeChronic" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="chronicPsych" role="tab" aria-selected="false">
                    <i class="fa-solid fa-brain"></i>
                    الأمراض النفسية
                    <span class="tab-badge" id="badgeChronicPsych" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="familyHistory" role="tab" aria-selected="false">
                    <i class="fa-solid fa-people-roof"></i>
                    التاريخ العائلي
                    <span class="tab-badge" id="badgeFamilyHistory" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="vitalSigns" role="tab" aria-selected="false">
                    <i class="fa-solid fa-heart-pulse"></i>
                    المؤشرات الحيوية
                    <span class="tab-badge" id="badgeVitalSigns" style="display:none">0</span>
                </button>
            </nav>
        </div>

        <!-- Group 2 -->
        <div class="nav-group">
            <div class="nav-group-header">
                <i class="fa-solid fa-clipboard-question"></i>
                <span>التقييمات النفسية</span>
                <span class="nav-group-count">5</span>
            </div>
            <nav class="patient-nav-tabs" role="tablist" aria-label="التقييمات النفسية">
                <button type="button" class="patient-tab-btn" data-tab="gad7" role="tab" aria-selected="false">
                    <i class="fa-solid fa-brain"></i>
                    القلق (GAD-7)
                </button>
                <button type="button" class="patient-tab-btn" data-tab="phq9" role="tab" aria-selected="false">
                    <i class="fa-solid fa-face-frown"></i>
                    الاكتئاب (PHQ-9)
                </button>
                <button type="button" class="patient-tab-btn" data-tab="mdq" role="tab" aria-selected="false">
                    <i class="fa-solid fa-bolt"></i>
                    ثنائي القطب (MDQ)
                </button>
                <button type="button" class="patient-tab-btn" data-tab="sds" role="tab" aria-selected="false">
                    <i class="fa-solid fa-chart-line"></i>
                    الإعاقة (SDS)
                </button>
                <button type="button" class="patient-tab-btn" data-tab="cssrs" role="tab" aria-selected="false">
                    <i class="fa-solid fa-shield-heart text-danger"></i>
                    الخطر (C-SSRS)
                </button>
            </nav>
        </div>

        <!-- Group 3 -->
        <div class="nav-group">
            <div class="nav-group-header">
                <i class="fa-solid fa-pills"></i>
                <span>العلاج والمتابعة</span>
                <span class="nav-group-count">5</span>
            </div>
            <nav class="patient-nav-tabs" role="tablist" aria-label="العلاج والمتابعة">
                <button type="button" class="patient-tab-btn" data-tab="diagnosis" role="tab" aria-selected="false">
                    <i class="fa-solid fa-stethoscope"></i>
                    التشخيص
                    <span class="tab-badge" id="badgeDiagnosis" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="prescribedMedications" role="tab" aria-selected="false">
                    <i class="fa-solid fa-prescription-bottle-medical"></i>
                    الأدوية الموصوفة
                    <span class="tab-badge" id="badgeMedications" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="treatmentPlans" role="tab" aria-selected="false">
                    <i class="fa-solid fa-diagram-project"></i>
                    الخطط العلاجية
                    <span class="tab-badge" id="badgeTreatmentPlans" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="sideEffects" role="tab" aria-selected="false">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    الأعراض الجانبية
                    <span class="tab-badge" id="badgeSideEffects" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="visits" role="tab" aria-selected="false">
                    <i class="fa-solid fa-calendar-check"></i>
                    الزيارات
                    <span class="tab-badge" id="badgeVisits" style="display:none">0</span>
                </button>
            </nav>
        </div>

        <!-- Group 4 -->
        <div class="nav-group">
            <div class="nav-group-header">
                <i class="fa-solid fa-folder-open"></i>
                <span>السجلات والملاحظات</span>
                <span class="nav-group-count">4</span>
            </div>
            <nav class="patient-nav-tabs" role="tablist" aria-label="السجلات والملاحظات">
                <button type="button" class="patient-tab-btn" data-tab="substanceUse" role="tab" aria-selected="false">
                    <i class="fa-solid fa-wine-bottle"></i>
                    تعاطي المواد
                    <span class="tab-badge" id="badgeSubstanceUse" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="listeningSessions" role="tab" aria-selected="false">
                    <i class="fa-solid fa-headphones"></i>
                    جلسات الاستماع
                    <span class="tab-badge" id="badgeListeningSessions" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="patientNotes" role="tab" aria-selected="false">
                    <i class="fa-solid fa-note-sticky"></i>
                    ملاحظات المريض
                    <span class="tab-badge" id="badgePatientNotes" style="display:none">0</span>
                </button>
                <button type="button" class="patient-tab-btn" data-tab="doctorNotes" role="tab" aria-selected="false">
                    <i class="fa-solid fa-user-doctor"></i>
                    ملاحظات الطبيب
                    <span class="tab-badge" id="badgeDoctorNotes" style="display:none">0</span>
                </button>
            </nav>
        </div>

    </div>

    <!-- Tab Content Container -->
    <div id="tabContentContainer" class="tab-content-container"></div>

</main>

@section Scripts {
    <script src="~/js/doctor/patientdetails.js"></script>
}