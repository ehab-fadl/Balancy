@page
@model Balancy.Areas.Doctor.Pages.Tabs.MedicationsModel
@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/doctor/tabs/medications.css" />

<div class="medications-container">

    <section class="medications-card">

        <div class="form-card-header">
            <div class="form-header-title">
                <div class="form-header-icon">
                    <i class="fa-solid fa-prescription-bottle-medical"></i>
                </div>
                <div>
                    <h1>الأدوية الموصوفة (Prescribed Medications)</h1>
                    <p>إدارة كاملة للأدوية الموصوفة للمريض</p>
                </div>
            </div>
            <div class="edit-status">
                <i class="fa-solid fa-clipboard-check"></i>
                <span id="medicationsCountBadge">0 دواء</span>
            </div>
        </div>

        <div class="personal-form">

            <!-- ====================== Form ====================== -->
            <div class="medication-form-card">
                <h3 id="medicationFormTitle" class="form-section-title">
                    <i class="fa-solid fa-plus-circle"></i>
                    إضافة دواء موصوف جديد
                </h3>

                <form id="medicationForm" novalidate>
                    <input type="hidden" id="medicationEditIndex" value="-1">

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="medicationName" class="form-label-custom">
                                <i class="fa-solid fa-pills"></i>
                                اسم الدواء
                            </label>
                            <input type="text" class="form-control form-control-custom" id="medicationName" name="medicationName" placeholder="مثال: سيرترالين..." required>
                        </div>

                        <div class="col-md-6">
                            <label for="medicationDose" class="form-label-custom">
                                <i class="fa-solid fa-scale-balanced"></i>
                                الجرعة
                            </label>
                            <input type="text" class="form-control form-control-custom" id="medicationDose" name="medicationDose" placeholder="مثال: 50 مغ" required>
                        </div>

                        <div class="col-md-6">
                            <label for="medicationFrequency" class="form-label-custom">
                                <i class="fa-solid fa-clock"></i>
                                التكرار
                            </label>
                            <select class="form-select form-control-custom" id="medicationFrequency" name="medicationFrequency" required>
                                <option value="">اختر التكرار</option>
                                <option value="مرة واحدة يومياً">مرة واحدة يومياً</option>
                                <option value="مرتين يومياً">مرتين يومياً</option>
                                <option value="ثلاث مرات يومياً">ثلاث مرات يومياً</option>
                                <option value="أربع مرات يومياً">أربع مرات يومياً</option>
                                <option value="عند الحاجة">عند الحاجة</option>
                                <option value="أسبوعياً">أسبوعياً</option>
                                <option value="شهرياً">شهرياً</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="medicationRoute" class="form-label-custom">
                                <i class="fa-solid fa-syringe"></i>
                                طريقة الإعطاء
                            </label>
                            <select class="form-select form-control-custom" id="medicationRoute" name="medicationRoute" required>
                                <option value="">اختر طريقة الإعطاء</option>
                                <option value="فموي (أقراص)">فموي (أقراص)</option>
                                <option value="فموي (شراب)">فموي (شراب)</option>
                                <option value="تحت اللسان">تحت اللسان</option>
                                <option value="حقن عضلي">حقن عضلي</option>
                                <option value="حقن وريدي">حقن وريدي</option>
                                <option value="حقن تحت الجلد">حقن تحت الجلد</option>
                                <option value="موضعي">موضعي</option>
                                <option value="استنشاق">استنشاق</option>
                                <option value="تحاميل">تحاميل</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="medicationStartDate" class="form-label-custom">
                                <i class="fa-solid fa-calendar-plus"></i>
                                تاريخ البدء
                            </label>
                            <input type="date" class="form-control form-control-custom" id="medicationStartDate" name="medicationStartDate" required>
                        </div>

                        <div class="col-md-6">
                            <label for="medicationEndDate" class="form-label-custom">
                                <i class="fa-solid fa-calendar-minus"></i>
                                تاريخ الانتهاء
                            </label>
                            <input type="date" class="form-control form-control-custom" id="medicationEndDate" name="medicationEndDate">
                        </div>

                        <div class="col-md-6">
                            <label for="medicationStatus" class="form-label-custom">
                                <i class="fa-solid fa-circle-check"></i>
                                الحالة
                            </label>
                            <select class="form-select form-control-custom" id="medicationStatus" name="medicationStatus" required>
                                <option value="">اختر الحالة</option>
                                <option value="نشط">نشط</option>
                                <option value="متوقف">متوقف</option>
                                <option value="مكتمل">مكتمل</option>
                                <option value="معلق مؤقتاً">معلق مؤقتاً</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="medicationNotes" class="form-label-custom">
                                <i class="fa-solid fa-note-sticky"></i>
                                ملاحظات
                            </label>
                            <textarea class="form-control form-control-custom" id="medicationNotes" name="medicationNotes" placeholder="ملاحظات إضافية..." style="min-height: 120px;"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4 flex-wrap">
                        <button type="button" id="medicationCancelBtn" class="btn btn-secondary px-4 py-2 d-none" style="border-radius: 14px; font-weight: 800;" onclick="resetMedicationForm()">
                            <i class="fa-solid fa-xmark ms-1"></i>
                            إلغاء التعديل
                        </button>
                        <button type="submit" id="medicationSubmitBtn" class="btn-save">
                            <i class="fa-solid fa-plus ms-1"></i>
                            إضافة الدواء
                        </button>
                    </div>
                </form>
            </div>

            <hr class="form-divider">

            <!-- ====================== Table ====================== -->
            <div class="form-section-title mb-3">
                <i class="fa-solid fa-list-check"></i>
                قائمة الأدوية الموصوفة
            </div>

            <div class="medication-table-wrapper">
                <table class="table table-hover align-middle medication-table table-mobile-cards mb-0" style="font-size: 0.9rem;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>اسم الدواء</th>
                            <th>الجرعة</th>
                            <th>التكرار</th>
                            <th>طريقة الإعطاء</th>
                            <th>تاريخ البدء</th>
                            <th>تاريخ الانتهاء</th>
                            <th>الحالة</th>
                            <th>ملاحظات</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="medicationTableBody"></tbody>
                </table>
            </div>

            <div id="medicationEmptyState" class="text-center text-muted py-4 d-none">
                <i class="fa-solid fa-folder-open fa-2x mb-2 text-secondary"></i>
                <p class="fw-bold mb-0">لا توجد أدوية موصوفة مسجلة لهذا المريض حتى الآن.</p>
            </div>

        </div>

    </section>

</div>


<!-- ============================================================
     Edit Modal
============================================================ -->
<div class="bn-modal-overlay" id="bnEditModal" role="dialog" aria-modal="true" aria-labelledby="bnEditModalTitle">
    <div class="bn-modal">
        <div class="bn-modal-header">
            <div class="bn-modal-header-icon">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <div class="bn-modal-header-text">
                <h3 id="bnEditModalTitle">تعديل</h3>
                <p id="bnEditModalSubtitle">قم بتعديل النص ثم اضغط حفظ</p>
            </div>
        </div>
        <div class="bn-modal-body">
            <label for="bnEditModalInput">
                <i class="fa-solid fa-keyboard"></i>
                <span id="bnEditModalLabel">النص</span>
            </label>
            <input type="text" id="bnEditModalInput" class="bn-modal-input" autocomplete="off">
        </div>
        <div class="bn-modal-footer">
            <button type="button" class="bn-btn bn-btn-ghost" id="bnEditModalCancel">
                <i class="fa-solid fa-xmark"></i>
                إلغاء
            </button>
            <button type="button" class="bn-btn bn-btn-primary" id="bnEditModalSave">
                <i class="fa-solid fa-floppy-disk"></i>
                حفظ التعديل
            </button>
        </div>
    </div>
</div>

<!-- ============================================================
     Confirm Modal
============================================================ -->
<div class="bn-modal-overlay" id="bnConfirmModal" role="dialog" aria-modal="true" aria-labelledby="bnConfirmModalTitle">
    <div class="bn-modal bn-modal-danger">
        <div class="bn-modal-header">
            <div class="bn-modal-header-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="bn-modal-header-text">
                <h3 id="bnConfirmModalTitle">تأكيد الحذف</h3>
                <p id="bnConfirmModalSubtitle">لا يمكن التراجع عن هذه العملية</p>
            </div>
        </div>
        <div class="bn-modal-body">
            <p class="bn-modal-message" id="bnConfirmModalMessage">هل أنت متأكد؟</p>
        </div>
        <div class="bn-modal-footer">
            <button type="button" class="bn-btn bn-btn-ghost" id="bnConfirmModalCancel">
                <i class="fa-solid fa-xmark"></i>
                إلغاء
            </button>
            <button type="button" class="bn-btn bn-btn-danger" id="bnConfirmModalConfirm">
                <i class="fa-solid fa-trash"></i>
                نعم، احذف
            </button>
        </div>
    </div>
</div>

<script src="~/js/doctor/tabs/medications.js"></script>