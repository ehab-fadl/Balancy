@page
@model Balancy.Areas.Doctor.Pages.Tabs.SideEffectsModel
@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/doctor/tabs/sideeffects.css" />

<div class="sideeffects-container">

    <section class="sideeffects-card">

        <div class="form-card-header">
            <div class="form-header-title">
                <div class="form-header-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <h1>الأعراض الجانبية للأدوية</h1>
                    <p>تسجيل ومتابعة الأعراض الجانبية المرتبطة بأدوية المريض</p>
                </div>
            </div>
            <div class="edit-status">
                <i class="fa-solid fa-clipboard-list"></i>
                <span id="sideEffectsCountBadge">0 عرض جانبي</span>
            </div>
        </div>

        <div class="personal-form">

            <!-- ====================== Form ====================== -->
            <div class="sideeffect-form-card">
                <h3 id="sideEffectFormTitle" class="form-section-title">
                    <i class="fa-solid fa-plus-circle"></i>
                    إضافة عرض جانبي جديد
                </h3>

                <form id="sideEffectForm" novalidate>
                    <input type="hidden" id="sideEffectEditIndex" value="-1">

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="sideEffectMedicationName" class="form-label-custom">
                                <i class="fa-solid fa-pills"></i>
                                اسم الدواء
                            </label>
                            <input type="text" class="form-control form-control-custom" id="sideEffectMedicationName" name="sideEffectMedicationName" placeholder="مثال: سيرترالين..." required>
                        </div>

                        <div class="col-md-6">
                            <label for="sideEffectSymptom" class="form-label-custom">
                                <i class="fa-solid fa-heart-pulse"></i>
                                الأعراض الجانبية
                            </label>
                            <input type="text" class="form-control form-control-custom" id="sideEffectSymptom" name="sideEffectSymptom" placeholder="مثال: غثيان، صداع..." required>
                        </div>

                        <div class="col-12">
                            <label for="sideEffectNotes" class="form-label-custom">
                                <i class="fa-solid fa-note-sticky"></i>
                                ملاحظات
                            </label>
                            <textarea class="form-control form-control-custom" id="sideEffectNotes" name="sideEffectNotes" placeholder="ملاحظات إضافية..." style="min-height: 120px;"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4 flex-wrap">
                        <button type="button" id="sideEffectCancelBtn" class="btn btn-secondary px-4 py-2 d-none" style="border-radius: 14px; font-weight: 800;" onclick="resetSideEffectForm()">
                            <i class="fa-solid fa-xmark ms-1"></i>
                            إلغاء التعديل
                        </button>
                        <button type="submit" id="sideEffectSubmitBtn" class="btn-save">
                            <i class="fa-solid fa-plus ms-1"></i>
                            إضافة العرض الجانبي
                        </button>
                    </div>
                </form>
            </div>

            <hr class="form-divider">

            <!-- ====================== Table ====================== -->
            <div class="form-section-title mb-3">
                <i class="fa-solid fa-list-check"></i>
                قائمة الأعراض الجانبية المسجلة
            </div>

            <div class="sideeffect-table-wrapper">
                <table class="table table-hover align-middle sideeffect-table table-mobile-cards mb-0" style="font-size: 0.9rem;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>اسم الدواء</th>
                            <th>الأعراض الجانبية</th>
                            <th>ملاحظات</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="sideEffectTableBody"></tbody>
                </table>
            </div>

            <div id="sideEffectEmptyState" class="text-center text-muted py-4 d-none">
                <i class="fa-solid fa-folder-open fa-2x mb-2 text-secondary"></i>
                <p class="fw-bold mb-0">لا توجد أعراض جانبية مسجلة لهذا المريض حتى الآن.</p>
            </div>

        </div>

    </section>

</div>


<!-- ============================================================
     Edit Modal
============================================================ -->
<div class="bn-modal-overlay" id="bnEditModal" role="dialog" aria-modal="true" aria-labelledby="bnEditModalTitle">
    <div class="bn-modal">
        <div class="bn-modal-header">
            <div class="bn-modal-header-icon">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <div class="bn-modal-header-text">
                <h3 id="bnEditModalTitle">تعديل</h3>
                <p id="bnEditModalSubtitle">قم بتعديل النص ثم اضغط حفظ</p>
            </div>
        </div>
        <div class="bn-modal-body">
            <label for="bnEditModalInput">
                <i class="fa-solid fa-keyboard"></i>
                <span id="bnEditModalLabel">النص</span>
            </label>
            <input type="text" id="bnEditModalInput" class="bn-modal-input" autocomplete="off">
        </div>
        <div class="bn-modal-footer">
            <button type="button" class="bn-btn bn-btn-ghost" id="bnEditModalCancel">
                <i class="fa-solid fa-xmark"></i>
                إلغاء
            </button>
            <button type="button" class="bn-btn bn-btn-primary" id="bnEditModalSave">
                <i class="fa-solid fa-floppy-disk"></i>
                حفظ التعديل
            </button>
        </div>
    </div>
</div>

<!-- ============================================================
     Confirm Modal
============================================================ -->
<div class="bn-modal-overlay" id="bnConfirmModal" role="dialog" aria-modal="true" aria-labelledby="bnConfirmModalTitle">
    <div class="bn-modal bn-modal-danger">
        <div class="bn-modal-header">
            <div class="bn-modal-header-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="bn-modal-header-text">
                <h3 id="bnConfirmModalTitle">تأكيد الحذف</h3>
                <p id="bnConfirmModalSubtitle">لا يمكن التراجع عن هذه العملية</p>
            </div>
        </div>
        <div class="bn-modal-body">
            <p class="bn-modal-message" id="bnConfirmModalMessage">هل أنت متأكد؟</p>
        </div>
        <div class="bn-modal-footer">
            <button type="button" class="bn-btn bn-btn-ghost" id="bnConfirmModalCancel">
                <i class="fa-solid fa-xmark"></i>
                إلغاء
            </button>
            <button type="button" class="bn-btn bn-btn-danger" id="bnConfirmModalConfirm">
                <i class="fa-solid fa-trash"></i>
                نعم، احذف
            </button>
        </div>
    </div>
</div>

<script src="~/js/doctor/tabs/sideeffects.js"></script>