@page
@model Balancy.Areas.Doctor.Pages.DocumentManagerModel
@{
}

<main class="doc-manager-main">

    <!-- Background Shapes -->
    <div class="bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>

    <div class="page-wrapper">
        <div class="doc-manager-layout">

            <!-- Sidebar -->
            <aside class="doc-sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-icon"><i class="fa-solid fa-folder-open"></i></div>
                    <div>
                        <h2 class="sidebar-title">خزانة الوثائق</h2>
                        <p class="sidebar-subtitle" id="patientNameSubtitle">وثائق المريض الداخلية والخارجية</p>
                    </div>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-title">حسب المصدر</div>
                    <ul class="sidebar-nav" role="tablist">
                        <li class="sidebar-item active" data-filter="all" role="tab">
                            <div class="sidebar-item-icon all"><i class="fa-solid fa-layer-group"></i></div>
                            <span class="sidebar-item-label">كل الوثائق</span>
                            <span class="sidebar-item-count" id="countAll">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="internal" role="tab">
                            <div class="sidebar-item-icon internal"><i class="fa-solid fa-hospital"></i></div>
                            <span class="sidebar-item-label">داخلية (Balancy)</span>
                            <span class="sidebar-item-count" id="countInternal">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="external" role="tab">
                            <div class="sidebar-item-icon external"><i class="fa-solid fa-cloud-arrow-down"></i></div>
                            <span class="sidebar-item-label">خارجية</span>
                            <span class="sidebar-item-count" id="countExternal">0</span>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-title">حسب النوع</div>
                    <ul class="sidebar-nav" role="tablist">
                        <li class="sidebar-item" data-filter="lab" role="tab">
                            <div class="sidebar-item-icon lab"><i class="fa-solid fa-flask-vial"></i></div>
                            <span class="sidebar-item-label">تحاليل مخبرية</span>
                            <span class="sidebar-item-count" id="countLab">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="rx" role="tab">
                            <div class="sidebar-item-icon rx"><i class="fa-solid fa-prescription-bottle-medical"></i></div>
                            <span class="sidebar-item-label">وصفات طبية</span>
                            <span class="sidebar-item-count" id="countRx">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="report" role="tab">
                            <div class="sidebar-item-icon report"><i class="fa-solid fa-file-medical"></i></div>
                            <span class="sidebar-item-label">تقارير طبية</span>
                            <span class="sidebar-item-count" id="countReport">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="imaging" role="tab">
                            <div class="sidebar-item-icon imaging"><i class="fa-solid fa-x-ray"></i></div>
                            <span class="sidebar-item-label">صور وأشعة</span>
                            <span class="sidebar-item-count" id="countImaging">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="referral" role="tab">
                            <div class="sidebar-item-icon referral"><i class="fa-solid fa-share-nodes"></i></div>
                            <span class="sidebar-item-label">إحالات / تحويلات</span>
                            <span class="sidebar-item-count" id="countReferral">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="consent" role="tab">
                            <div class="sidebar-item-icon consent"><i class="fa-solid fa-signature"></i></div>
                            <span class="sidebar-item-label">موافقات مستنيرة</span>
                            <span class="sidebar-item-count" id="countConsent">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="certificate" role="tab">
                            <div class="sidebar-item-icon cert"><i class="fa-solid fa-file-circle-check"></i></div>
                            <span class="sidebar-item-label">شهادات / إجازات</span>
                            <span class="sidebar-item-count" id="countCertificate">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="discharge" role="tab">
                            <div class="sidebar-item-icon discharge"><i class="fa-solid fa-door-open"></i></div>
                            <span class="sidebar-item-label">ملخصات خروج</span>
                            <span class="sidebar-item-count" id="countDischarge">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="record" role="tab">
                            <div class="sidebar-item-icon record"><i class="fa-solid fa-file-shield"></i></div>
                            <span class="sidebar-item-label">سجلات سابقة</span>
                            <span class="sidebar-item-count" id="countRecord">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="attachment" role="tab">
                            <div class="sidebar-item-icon attach"><i class="fa-solid fa-paperclip"></i></div>
                            <span class="sidebar-item-label">مرفقات عامة</span>
                            <span class="sidebar-item-count" id="countAttachment">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="other" role="tab">
                            <div class="sidebar-item-icon other"><i class="fa-solid fa-file"></i></div>
                            <span class="sidebar-item-label">أخرى</span>
                            <span class="sidebar-item-count" id="countOther">0</span>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-title">حالات خاصة</div>
                    <ul class="sidebar-nav" role="tablist">
                        <li class="sidebar-item" data-filter="critical" role="tab">
                            <div class="sidebar-item-icon critical"><i class="fa-solid fa-lock"></i></div>
                            <span class="sidebar-item-label">حساسة / محمية</span>
                            <span class="sidebar-item-count" id="countCritical">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="expired" role="tab">
                            <div class="sidebar-item-icon expired"><i class="fa-solid fa-hourglass-end"></i></div>
                            <span class="sidebar-item-label">منتهية الصلاحية</span>
                            <span class="sidebar-item-count" id="countExpired">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="favorite" role="tab">
                            <div class="sidebar-item-icon fav"><i class="fa-solid fa-star"></i></div>
                            <span class="sidebar-item-label">المفضلة</span>
                            <span class="sidebar-item-count" id="countFavorite">0</span>
                        </li>
                        <li class="sidebar-item" data-filter="deleted" role="tab">
                            <div class="sidebar-item-icon trash"><i class="fa-solid fa-trash"></i></div>
                            <span class="sidebar-item-label">سلة المحذوفات</span>
                            <span class="sidebar-item-count" id="countDeleted">0</span>
                        </li>
                    </ul>
                </div>
            </aside>

            <!-- Main -->
            <main class="doc-main">

                <!-- Patient Banner -->
                <div class="patient-banner" id="patientBanner" style="display:none;">
                    <div class="patient-banner-icon"><i class="fa-solid fa-user"></i></div>
                    <div class="patient-banner-info">
                        <div class="patient-banner-label">خزانة وثائق المريض</div>
                        <div class="patient-banner-name" id="patientBannerName">-</div>
                    </div>
                    <div class="patient-banner-id">
                        <i class="fa-solid fa-hashtag"></i>
                        <span id="patientBannerId">-</span>
                    </div>
                </div>

                <!-- Stats -->
                <div class="stats-bar">
                    <div class="stat-card total">
                        <div class="stat-icon total"><i class="fa-solid fa-folder"></i></div>
                        <div class="stat-info">
                            <span class="stat-label">إجمالي الوثائق</span>
                            <span class="stat-value" id="statTotal">0</span>
                        </div>
                    </div>
                    <div class="stat-card internal">
                        <div class="stat-icon internal"><i class="fa-solid fa-hospital"></i></div>
                        <div class="stat-info">
                            <span class="stat-label">داخلية</span>
                            <span class="stat-value" id="statInternal">0</span>
                        </div>
                    </div>
                    <div class="stat-card external">
                        <div class="stat-icon external"><i class="fa-solid fa-cloud-arrow-down"></i></div>
                        <div class="stat-info">
                            <span class="stat-label">خارجية</span>
                            <span class="stat-value" id="statExternal">0</span>
                        </div>
                    </div>
                    <div class="stat-card critical">
                        <div class="stat-icon critical"><i class="fa-solid fa-lock"></i></div>
                        <div class="stat-info">
                            <span class="stat-label">حساسة</span>
                            <span class="stat-value" id="statCritical">0</span>
                        </div>
                    </div>
                </div>

                <!-- Toolbar -->
                <div class="doc-toolbar">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" class="search-input" id="searchInput"
                               placeholder="ابحث بالاسم أو الوسم أو الجهة المصدرة..." aria-label="بحث">
                    </div>

                    <select class="filter-select" id="filterSource" aria-label="المصدر">
                        <option value="">كل المصادر</option>
                        <option value="internal">داخلية</option>
                        <option value="external">خارجية</option>
                    </select>

                    <select class="filter-select" id="filterDate" aria-label="فلتر التاريخ">
                        <option value="">كل التواريخ</option>
                        <option value="today">اليوم</option>
                        <option value="week">آخر 7 أيام</option>
                        <option value="month">آخر 30 يوم</option>
                        <option value="year">آخر سنة</option>
                    </select>

                    <select class="filter-select" id="sortBy" aria-label="الترتيب">
                        <option value="newest">الأحدث أولاً</option>
                        <option value="oldest">الأقدم أولاً</option>
                        <option value="name">الاسم (أ-ي)</option>
                        <option value="size">الحجم</option>
                    </select>

                    <div class="view-toggle">
                        <button type="button" class="view-toggle-btn active" id="viewGrid" title="شبكة">
                            <i class="fa-solid fa-grip"></i>
                        </button>
                        <button type="button" class="view-toggle-btn" id="viewList" title="قائمة">
                            <i class="fa-solid fa-list"></i>
                        </button>
                    </div>

                    <button type="button" class="btn-upload" id="uploadBtn">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        رفع وثيقة
                    </button>
                </div>

                <div class="documents-area">
                    <div class="docs-grid" id="docsContainer"></div>
                </div>

            </main>
        </div>
    </div>

    <!-- Drop overlay -->
    <div class="drop-overlay" id="dropOverlay">
        <div class="drop-zone">
            <div class="drop-zone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <h2>أفلت الملفات هنا</h2>
            <p>سيتم رفعها إلى خزانة وثائق المريض</p>
        </div>
    </div>

    <!-- FAB -->
    <div class="bn-fab">
        <button type="button" class="bn-fab-btn" id="fabUpload" aria-label="رفع وثيقة" title="رفع وثيقة">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    <!-- Upload Modal -->
    <div class="bn-modal-overlay" id="uploadModal" role="dialog" aria-modal="true">
        <div class="bn-modal lg">
            <div class="bn-modal-header">
                <div class="bn-modal-header-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                <div class="bn-modal-header-text">
                    <h3 id="uploadModalTitle">رفع وثيقة جديدة</h3>
                    <p id="uploadModalSubtitle">وثيقة داخلية أو خارجية للمريض</p>
                </div>
                <button type="button" class="btn-close" id="uploadModalClose" aria-label="إغلاق"></button>
            </div>

            <div class="bn-modal-body">
                <form id="uploadForm" novalidate>
                    <input type="hidden" id="uploadEditId" value="">

                    <div class="upload-drop-area" id="uploadDropArea">
                        <div class="upload-drop-icon"><i class="fa-solid fa-file-arrow-up"></i></div>
                        <h4>اختر ملفاً أو اسحبه هنا</h4>
                        <p>PDF، صور، Word، Excel — بحد أقصى 50 ميجابايت</p>
                        <input type="file" id="fileInput" style="display: none;"
                               accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx,.txt,.dcm,.zip">
                    </div>

                    <div class="selected-file-info" id="selectedFileInfo">
                        <div class="selected-file-icon"><i class="fa-solid fa-file" id="selectedFileIcon"></i></div>
                        <div class="selected-file-details">
                            <div class="selected-file-name" id="selectedFileName">-</div>
                            <div class="selected-file-size" id="selectedFileSize">-</div>
                        </div>
                        <button type="button" class="selected-file-remove" id="removeFileBtn" aria-label="إزالة">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="docSourceType"><i class="fa-solid fa-arrows-left-right"></i> مصدر الوثيقة</label>
                            <select class="form-control-custom" id="docSourceType" required>
                                <option value="external">خارجية (من جهة أخرى)</option>
                                <option value="internal">داخلية (من Balancy)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="docType"><i class="fa-solid fa-tag"></i> نوع الوثيقة</label>
                            <select class="form-control-custom" id="docType" required>
                                <option value="">اختر النوع</option>
                                <option value="lab">تحليل مخبري</option>
                                <option value="rx">وصفة طبية</option>
                                <option value="report">تقرير طبي</option>
                                <option value="imaging">صورة / أشعة</option>
                                <option value="referral">إحالة / تحويل</option>
                                <option value="consent">موافقة مستنيرة</option>
                                <option value="certificate">شهادة / إجازة مرضية</option>
                                <option value="discharge">ملخص خروج</option>
                                <option value="record">سجل طبي سابق</option>
                                <option value="attachment">مرفق عام</option>
                                <option value="other">أخرى</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="docName"><i class="fa-solid fa-heading"></i> اسم الوثيقة</label>
                            <input type="text" class="form-control-custom" id="docName"
                                   placeholder="مثال: تقرير مختبر السلام — تحليل دم شامل" required>
                        </div>

                        <div class="col-md-6">
                            <label for="docDate"><i class="fa-solid fa-calendar-days"></i> تاريخ الوثيقة</label>
                            <input type="date" class="form-control-custom" id="docDate" required>
                        </div>

                        <div class="col-md-6">
                            <label for="docIssuer"><i class="fa-solid fa-building-columns"></i> الجهة المصدرة / الطبيب</label>
                            <input type="text" class="form-control-custom" id="docIssuer"
                                   placeholder="مثال: مستشفى المدينة — قسم الأشعة">
                        </div>

                        <div class="col-md-6">
                            <label for="docCategory"><i class="fa-solid fa-folder-tree"></i> تصنيف فرعي (اختياري)</label>
                            <input type="text" class="form-control-custom" id="docCategory"
                                   placeholder="مثال: متابعة ربع سنوية">
                        </div>

                        <div class="col-md-6">
                            <label for="docRefNo"><i class="fa-solid fa-barcode"></i> رقم مرجعي / باركود</label>
                            <input type="text" class="form-control-custom" id="docRefNo"
                                   placeholder="مثال: LAB-2024-0045">
                        </div>

                        <div class="col-md-6">
                            <label for="docExpiry"><i class="fa-solid fa-hourglass-end"></i> تاريخ انتهاء الصلاحية</label>
                            <input type="date" class="form-control-custom" id="docExpiry">
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <label style="display:flex; align-items:center; gap:.5rem; cursor:pointer; font-size:.85rem; width:100%;">
                                <input type="checkbox" id="docSigned" style="width:18px; height:18px; accent-color:#10b981;">
                                <i class="fa-solid fa-signature" style="color:#10b981;"></i>
                                <span>الوثيقة موقّعة / معتمدة</span>
                            </label>
                        </div>

                        <div class="col-12">
                            <label style="display:flex; align-items:center; gap:.5rem; cursor:pointer; font-size:.85rem;">
                                <input type="checkbox" id="docCritical" style="width:18px; height:18px; accent-color:#ef4444;">
                                <i class="fa-solid fa-lock" style="color:#ef4444;"></i>
                                <span>وثيقة حساسة (تقييد الوصول)</span>
                            </label>
                        </div>

                        <div class="col-12">
                            <label for="tagInput"><i class="fa-solid fa-hashtag"></i> الوسوم (اضغط Enter)</label>
                            <div class="tags-input-wrapper" id="tagsWrapper">
                                <input type="text" id="tagInput" placeholder="أضف وسماً...">
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="docNotes"><i class="fa-solid fa-note-sticky"></i> ملاحظات وصفية (اختياري)</label>
                            <textarea class="form-control-custom" id="docNotes"
                                      placeholder="وصف موجز لمحتوى الوثيقة..."></textarea>
                        </div>
                    </div>
                </form>
            </div>

            <div class="bn-modal-footer">
                <button type="button" class="bn-btn bn-btn-ghost" id="uploadCancelBtn">
                    <i class="fa-solid fa-xmark"></i> إلغاء
                </button>
                <button type="button" class="bn-btn bn-btn-primary" id="uploadSaveBtn">
                    <i class="fa-solid fa-cloud-arrow-up"></i> حفظ الوثيقة
                </button>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="bn-modal-overlay" id="previewModal" role="dialog" aria-modal="true">
        <div class="bn-modal lg">
            <div class="doc-preview-header">
                <div class="bn-modal-header-icon" id="previewIcon"><i class="fa-solid fa-file"></i></div>
                <div class="bn-modal-header-text">
                    <h3 id="previewTitle">-</h3>
                    <p id="previewSubtitle">-</p>
                </div>
                <button type="button" class="btn-close" id="previewCloseBtn" aria-label="إغلاق" style="filter: invert(1);"></button>
            </div>
            <div class="bn-modal-body">
                <div id="previewSensitiveNotice" style="display:none;"></div>
                <div class="doc-preview-body">
                    <div class="doc-preview-thumbnail" id="previewThumbnail">
                        <i class="fa-solid fa-file" id="previewThumbIcon"></i>
                    </div>
                    <div class="doc-preview-info" id="previewInfo"></div>
                </div>
            </div>
            <div class="bn-modal-footer">
                <button type="button" class="bn-btn bn-btn-ghost" id="previewDownloadBtn">
                    <i class="fa-solid fa-download"></i> تحميل
                </button>
                <button type="button" class="bn-btn bn-btn-ghost" id="previewPrintBtn">
                    <i class="fa-solid fa-print"></i> طباعة
                </button>
                <button type="button" class="bn-btn bn-btn-primary" id="previewCloseBtn2">
                    <i class="fa-solid fa-check"></i> إغلاق
                </button>
            </div>
        </div>
    </div>

    <!-- Confirm Modal -->
    <div class="bn-modal-overlay" id="confirmModal" role="dialog" aria-modal="true">
        <div class="bn-modal bn-modal-danger">
            <div class="bn-modal-header">
                <div class="bn-modal-header-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <div class="bn-modal-header-text">
                    <h3 id="confirmTitle">تأكيد الحذف</h3>
                    <p id="confirmSubtitle">لا يمكن التراجع عن هذه العملية</p>
                </div>
            </div>
            <div class="bn-modal-body">
                <p id="confirmMessage" style="font-size: 0.9rem; color: var(--bn-text-soft); line-height: 1.8; font-weight: 600;">هل أنت متأكد؟</p>
            </div>
            <div class="bn-modal-footer">
                <button type="button" class="bn-btn bn-btn-ghost" id="confirmCancelBtn">
                    <i class="fa-solid fa-xmark"></i> إلغاء
                </button>
                <button type="button" class="bn-btn bn-btn-danger" id="confirmOkBtn">
                    <i class="fa-solid fa-trash"></i> نعم، احذف
                </button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container">
        <div id="notificationToast" class="toast toast-custom" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body">
                <div class="toast-icon-wrap" id="toastIcon"></div>
                <div class="toast-content">
                    <strong id="toastTitle"></strong>
                    <div id="toastMessage" class="small"></div>
                </div>
                <button type="button" class="btn-close" id="toastCloseBtn" aria-label="إغلاق"></button>
            </div>
            <div class="toast-progress"><div class="toast-progress-bar" id="toastProgressBar"></div></div>
        </div>
    </div>

</main>

<script src="~/js/doctor/documentmanager/documentmanager.js"></script>