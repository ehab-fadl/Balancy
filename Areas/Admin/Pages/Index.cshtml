@page
@model Balancy.Areas.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "لوحة التحكم - إدارة المستخدمين";
}

<div class="container-fluid px-4">

    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">
            <i class="fa-solid fa-users-gear"></i>
            إدارة المستخدمين
        </h1>
        <ul class="breadcrumb-custom">
            <li><a href="#">الرئيسية</a></li>
            <li>لوحة التحكم</li>
            <li>المستخدمين</li>
        </ul>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl col-md-4 col-sm-6">
            <div class="stat-card total">
                <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
                <div class="stat-info">
                    <h3>@Model.TotalUsers</h3>
                    <span>إجمالي المستخدمين</span>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="stat-card admin">
                <div class="stat-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <div class="stat-info">
                    <h3>@Model.AdminCount</h3>
                    <span>مديرو النظام</span>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="stat-card doctor">
                <div class="stat-icon"><i class="fa-solid fa-user-doctor"></i></div>
                <div class="stat-info">
                    <h3>@Model.DoctorCount</h3>
                    <span>الأطباء</span>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="stat-card searcher">
                <div class="stat-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                <div class="stat-info">
                    <h3>@Model.SearcherCount</h3>
                    <span>الباحثون</span>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="stat-card active">
                <div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div>
                <div class="stat-info">
                    <h3>@Model.ActiveUsersCount</h3>
                    <span>الحسابات النشطة</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table Card -->
    <div class="content-card">
        <!-- نموذج البحث -->
        <form method="get" class="card-header-custom m-0">
            <div class="card-header-title">
                <i class="fa-solid fa-list-ul"></i>
                قائمة المستخدمين
            </div>
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="SearchQuery" value="@Model.SearchQuery" placeholder="البحث باسم المستخدم أو الإيميل...">
            </div>
        </form>

        <div class="table-wrap">
            <table class="balancy-table">
                <thead>
                    <tr>
                        <th>المستخدم</th>
                        <th>البريد الإلكتروني</th>
                        <th>رقم الهاتف</th>
                        <th>الدور</th>
                        <th>الحالة</th>
                        <th style="text-align:center;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users != null && Model.Users.Any())
                    {
                        foreach (var user in Model.Users)
                        {
                            string avatarBg = user.Role switch
                            {
                                "Admin" => "0d9488",
                                "Doctor" => "3b82f6",
                                "Searcher" => "10b981",
                                _ => "94a3b8"
                            };

                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString($"{user.FirstName} {user.LastName}")&background=@avatarBg&color=fff&size=128" alt="@user.FirstName">
                                        <div>
                                            <span class="name">@user.FirstName @user.LastName</span>
                                            <span class="email">@user.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "غير متوفر" : user.PhoneNumber)</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="role-badge role-admin"><i class="fa-solid fa-crown" style="font-size:0.65rem;"></i> Admin</span>
                                    }
                                    else if (user.Role == "Doctor")
                                    {
                                        <span class="role-badge role-doctor"><i class="fa-solid fa-stethoscope" style="font-size:0.65rem;"></i> Doctor</span>
                                    }
                                    else if (user.Role == "Searcher")
                                    {
                                        <span class="role-badge role-searcher"><i class="fa-solid fa-magnifying-glass" style="font-size:0.65rem;"></i> Searcher</span>
                                    }
                                    else
                                    {
                                        <span class="role-badge role-null"><i class="fa-solid fa-circle" style="font-size:0.5rem;"></i> NullUser</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="status-badge status-active"><span class="status-dot"></span> نشط</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive"><span class="status-dot"></span> معطل</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-btns">
                                        <a asp-page="ViewUser" asp-route-id="@user.Id" class="btn-action btn-view" title="عرض التفاصيل"><i class="fa-solid fa-eye"></i></a>
                                        <a asp-page="EditView" asp-route-id="@user.Id" class="btn-action btn-edit" title="تعديل"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-page="AssignRole" asp-route-id="@user.Id" class="btn-action btn-role" title="تعيين الدور"><i class="fa-solid fa-user-tag"></i></a>

                                        <!-- زر تفعيل/تعطيل الحساب المرتبط بالـ Handler -->
                                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id" style="display:inline;">
                                            <button type="submit" class="btn-action btn-toggle" title="@(user.IsActive ? "تعطيل الحساب" : "تفعيل الحساب")" style="border:none; background:none; cursor:pointer;">
                                                <i class="fa-solid @(user.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-muted")"></i>
                                            </button>
                                        </form>

                                        <a asp-page="DeleteUser" asp-route-id="@user.Id" class="btn-action btn-delete" title="حذف"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">لا توجد نتائج مطابقة لعملية البحث أو تعذر الاتصال بالسيرفر.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="card-footer-custom">
            @{
                int startIndex = Model.Users.Count == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                int endIndex = startIndex + Model.Users.Count - 1;
            }
            <span class="showing-text">عرض <strong>@startIndex-@endIndex</strong> من النتائج</span>

            <ul class="pagination-custom">
                @if (Model.CurrentPage > 1)
                {
                    <li><a href="?CurrentPage=@(Model.CurrentPage - 1)&SearchQuery=@Model.SearchQuery"><i class="fa-solid fa-chevron-right"></i></a></li>
                }
                else
                {
                    <li><a href="#" class="disabled" style="opacity: 0.5; pointer-events: none;"><i class="fa-solid fa-chevron-right"></i></a></li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li>
                        <a href="?CurrentPage=@i&SearchQuery=@Model.SearchQuery" class="@(i == Model.CurrentPage ? "active" : "")">@i</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li><a href="?CurrentPage=@(Model.CurrentPage + 1)&SearchQuery=@Model.SearchQuery"><i class="fa-solid fa-chevron-left"></i></a></li>
                }
                else
                {
                    <li><a href="#" class="disabled" style="opacity: 0.5; pointer-events: none;"><i class="fa-solid fa-chevron-left"></i></a></li>
                }
            </ul>
        </div>
    </div>

</div>
<script src="~/js/admin/index.js"></script>