@page
@model Balancy.Pages.AccessDeniedModel
@{
}


<div class="text-center py-5">
    <h1 class="text-danger display-1 fw-bold">403</h1>
    <h2 class="fw-bold">غير مصرح لك بالدخول لهذه الصفحة</h2>
    <p class="text-muted">ليس لديك الصلاحيات الكافية لعرض هذه الصفحة.</p>
    <a href="/Login" class="btn btn-primary mt-3">العودة للرئيسية</a>
    <form method="post" asp-page="/Logout" asp-area="" class="d-none d-lg-flex m-0 p-0">
        <button type="submit" class="btn-logout-main border-0" style="cursor: pointer;">
            <i class="fa-solid fa-power-off"></i>
            <span>تسجيل الخروج</span>
        </button>
    </form>
</div>
