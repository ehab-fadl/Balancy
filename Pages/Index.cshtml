@page
@model Balancy.Pages.IndexModel
@{
}
<div class="container">

    <!-- VIEW 1: Welcome View (Landing / Logged out state) -->
    <div id="home-view" class="app-view active-view">
        <div class="bg-shape shape-1"></div>
        <div class="bg-shape shape-2"></div>
        <div class="welcome-card">
            <div class="welcome-icon-wrapper">
                <i class="fa-solid fa-hand-holding-heart"></i>
            </div>
            <h1 class="welcome-title">مرحباً بك في بالنسي</h1>
            <p class="welcome-subtitle">نحو حياة خالية من الاكتئاب</p>
            <div class="welcome-divider"></div>
            <p class="welcome-message">
                يجب عليك <strong>تسجيل الدخول</strong> للاستفادة من خدمات النظام بشكل كامل.<br>
                إذا كنت لا تمتلك حساباً، يمكنك إنشاء حساب جديد الآن.
            </p>
            <div class="btn-group-custom">
                <a class="btn-welcome btn-login-action" onclick="switchView('dashboard-view')" asp-page="/Login">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    تسجيل الدخول
                </a>
                <a class="btn-welcome btn-register-action" asp-page="/Register">
                    <i class="fa-solid fa-user-plus"></i>
                    تسجيل مستخدم جديد
                </a>
            </div>
        </div>
    </div>
    </div>